#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE       &kp N1  &kp N2    &kp N3        &kp N4  &kp N5                                    &kp N6      &kp N7  &kp N8     &kp N9     &kp N0            &kp SLASH
&kp ESCAPE      &kp Q   &kp W     &kp E         &kp R   &kp T          &kp Y                                  &kp U   &kp I      &kp O      &kp P             &kp BACKSLASH
&kp TAB         &kp A   &kp S     &kp D         &kp F   &kp G          &kp H                                  &kp J   &kp K      &kp L      &kp SEMI          &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X     &kp C         &kp V   &kp B          &kp ESCAPE  &kp RIGHT_ALT  &kp N       &kp M   &kp COMMA  &kp DOT    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                        &kp LALT  &kp LEFT_GUI  &mo 1   &kp BACKSPACE  &kp SPACE   &kp ENTER      &kp DELETE  &mo 2   &kp MINUS  &kp EQUAL
            >;
        };

        lower_layer {
            bindings = <
&kp F1  &kp F2        &kp F3    &kp F4    &kp F5     &kp F6                                  &kp F7  &kp F8    &kp F9    &kp F10    &kp F11         &kp F12
&trans  &kp CAPSLOCK  &kp HOME  &kp UP    &kp END    &kp PAGE_UP      &kp PAGE_UP                    &kp HOME  &kp UP    &kp END    &kp SCROLLLOCK  &none
&trans  &kp UP        &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN    &kp PAGE_DOWN                  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DOWN        &none
&trans  &none         &none     &none     &kp INS    &kp PRINTSCREEN  &trans         &trans  &none   &none     &none     &none      &none           &none
                      &trans    &trans    &trans     &trans           &trans         &trans  &trans  &trans    &none     &none
            >;

            label = "lower";
        };

        upper_layer {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none                         &kp KP_NUM    &kp KP_N7  &kp KP_N7  &kp KP_N9   &kp KP_MINUS     &none
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none   &kp K_MUTE                          &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_PLUS      &none
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none   &kp C_VOL_UP                        &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_DIVIDE    &none
&trans  &none   &none    &none    &none    &none   &trans        &trans  &kp C_VOL_DN  &kp EQUAL  &kp KP_N0  &kp KP_DOT  &kp KP_MULTIPLY  &none
                &trans   &trans   &trans   &trans  &trans        &trans  &trans        &trans     &none      &none
            >;

            label = "upper";
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                             &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &none                          &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &none                          &none  &none  &none  &none  &none
&none              &none            &none            &bootloader      &sys_reset       &studio_unlock   &rgb_ug RGB_TOG  &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none            &none  &none  &none  &none  &none
            >;
        };
    };
};
